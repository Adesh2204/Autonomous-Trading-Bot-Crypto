+        r['final_orders'] = account.get_frontend_open_orders()
+        if r['final_positions'] or r['final_orders']:
+            r['status'] = 'PREFLIGHT_BLOCKED'; r['blocker'] = 'ACCOUNT_CHANGED_DURING_PROPOSAL'
+        r['rates'] = rates.report()
+    except Exception as exc:
