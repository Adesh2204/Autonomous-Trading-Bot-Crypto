{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/libquant_engine",
        "${workspaceFolder}/.venv/include",
        "${workspaceFolder}/.venv/lib/python3.12/site-packages/pybind11/include",
        "/Library/Frameworks/Python.framework/Versions/3.12/include/python3.12",
        "/usr/local/include",
        "/opt/homebrew/include"
      ],
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-x64"
    }
  ],
  "version": 4
}
